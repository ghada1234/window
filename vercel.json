{
  "rewrites": [
    {
      "source": "/((?!api/.*|emergency\\.html|basic\\.html|test\\.html|mobile-test\\.html|unregister-sw\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
