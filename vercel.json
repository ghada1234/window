{
  "rewrites": [
    {
      "source": "/((?!api/.*|emergency\\.html|basic\\.html|test\\.html|mobile-test\\.html|unregister-sw\\.html|index-mobile\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/mobile",
      "destination": "/index-mobile.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
